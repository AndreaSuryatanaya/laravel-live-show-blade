      "locked": false,
      "text": "Create CRUD Project\n1. Buat controller\n    - php artisan make:controller BookController --resource\n2. Buat tampilan views\n    - dengan template yang sudah ada\n3. Tambahkan views di Controller -> function index\n4. Tambahkan routing baru menuju Controller -> function index\n5. Edit .env\n    - update value database\n6. buat migration\n    - php artisan make:migration create_table_book\n    - edit data migration\n        - id\n        - title\n        - author\n        - publish_year \n     - php artisan migrate\n7. buat seeder\n    - php artisan make:seeder BookSeeder\n    - edit function run\n    - DB:table('book')->insert($buku);\n    - jalankan seed\n            - php artisan db:seed --class=BookSeeder\n8. Penjelasan tentang Model (Representasi Database)\n9. Membuat model\n    - php artisan make:model Book\n    - edit file Model Book\n            - protected $table = 'book';\n            - protected $fillable = ['title', 'author', 'publish_year'];\n10. Panggil model di Controller\n    - inject ke views\n11. Pindah ke views\n    - buat looping foreach\n        @foreach\n12. gunakan $loop->iteration untuk ID supaya urut\n13. membuat function untuk create book\n    - buat controller baru function create->view.form.create-book\n    - buat controller baru function strore->post data book\n    - tambahkan routing POST ke Controller->store\n    - aplikasikan penandi ->name pada routing\n    - tambahkan {{ route{buku.store }}} pada action form\n14. buat validasi pada controller\n    $validated = $request->validate([\n            'judul' => 'required|min:3',\n            'pengarang' => 'required|min:3',\n            'tahun_terbit' => 'required'\n        ]);\n    Buku::create($validated);\n        return redirect()->route('buku.index')->with('success', 'Buku berhasil ditambahkan!');\n15. tambahkan \n    - @csrf pada form\n    - tambahkan redirect ke buku.index\n    - tambahkan notifikasi pop up success\n            - @if (session('success'))\n            <div class=\"alert alert-success alert-dismissible fade show\" role=\"alert\">\n                {{ session('success') }}\n                <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"alert\" aria-label=\"Close\"></button>\n            </div>\n        @endif\n    - tambahkan notifikasi pop up error\n        @if ($errors->any())\n            <div class=\"alert alert-danger alert-dismissible fade show\" role=\"alert\">\n                <ul class=\"mb-0\">\n                    @foreach ($errors->all() as $error)\n                        <li>{{ $error }}</li>\n                    @endforeach\n                </ul>\n                <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"alert\" aria-label=\"Close\"></button>\n            </div>\n        @endif\n16. Update data book\n        - buat views form Edit Book\n        - buat controller -> edit . untuk menuju view edit dan kirim juga data book\n            - $book = Book::findOrFail($id); //Cari data by ID\n              return view('book.edit-book', compact('book'));\n        - jangan lupa \n            -@csrf\n            @method('PUT')\n            di dalam form\n17. Render data book pada value\n        - {{ old('title', $book['title'] ?? $book->title) }}\n18. Buat function update\n        - lakukan validasi\n            - $validated = $request->validate([\n            'title' => 'required|min:3',\n            'author' => 'required|min:3',\n            'publish_year' => 'required'\n        ]);\n\n        - cari book by ID\n            $book = Book::findOrFail($id);\n        - update data book\n            $book->update($validated);\n        - redirect ke index\n         return redirect()->route('book.index')->with('success', 'Success updated data book');\n19 . Buat route baru \n        - Route::put('/update-book/{id}', [BookController::class, 'update'])->name('book.update');\n20. tambah kan route di form beserta kirimkan juga id nya \n        -    <form action=\"{{ route('book.update', $book['id'] ?? $book->id) }}\" method=\"POST\">\n        - tambahkan juga \n                - @csrf\n                   @method('PUT') <!-- Wajib ada untuk request update di Laravel -->\n21. Membuat fitur Delete\n    - buat route baru \n        - Route::delete('/delete-book/{id}', [BookController::class, 'destroy'])->name('book.destroy');\n    - edit controller -> destroy\n        - cari by ID kemudian delete\n            -$book = Book::findOrFail($id);\n             $book->delete();\n    - redirect ke index\n            - return redirect()->route('book.index')->with('success', 'Deleted book successfully');\n    - panggil route delete di tombol delete menggunakan form\n        - <form action=\"{{ route('book.destroy', $item['id'] ?? $item->id) }}\"\n                                            method=\"POST\" class=\"inline-block m-0\"\n                                            onsubmit=\"return confirm('Are you sure, Delete ?')\">\n                                            @csrf\n                                            @method('DELETE')\n                                            <button type=\"submit\"\n                                                class=\"p-2 text-red-600 hover:bg-red-50 rounded-lg transition\"\n                                                title=\"Delete\">\n                                                <i class=\"fas fa-trash-alt\"></i>\n                                            </button>\n                                        </form>\n\n\n\n\n        \n    \n",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Create CRUD Project\n1. Buat controller\n    - php artisan make:controller BookController --resource\n2. Buat tampilan views\n    - dengan template yang sudah ada\n3. Tambahkan views di Controller -> function index\n4. Tambahkan routing baru menuju Controller -> function index\n5. Edit .env\n    - update value database\n6. buat migration\n    - php artisan make:migration create_table_book\n    - edit data migration\n        - id\n        - title\n        - author\n        - publish_year \n     - php artisan migrate\n7. buat seeder\n    - php artisan make:seeder BookSeeder\n    - edit function run\n    - DB:table('book')->insert($buku);\n    - jalankan seed\n            - php artisan db:seed --class=BookSeeder\n8. Penjelasan tentang Model (Representasi Database)\n9. Membuat model\n    - php artisan make:model Book\n    - edit file Model Book\n            - protected $table = 'book';\n            - protected $fillable = ['title', 'author', 'publish_year'];\n10. Panggil model di Controller\n    - inject ke views\n11. Pindah ke views\n    - buat looping foreach\n        @foreach\n12. gunakan $loop->iteration untuk ID supaya urut\n13. membuat function untuk create book\n    - buat controller baru function create->view.form.create-book\n    - buat controller baru function strore->post data book\n    - tambahkan routing POST ke Controller->store\n    - aplikasikan penandi ->name pada routing\n    - tambahkan {{ route{buku.store }}} pada action form\n14. buat validasi pada controller\n    $validated = $request->validate([\n            'judul' => 'required|min:3',\n            'pengarang' => 'required|min:3',\n            'tahun_terbit' => 'required'\n        ]);\n    Buku::create($validated);\n        return redirect()->route('buku.index')->with('success', 'Buku berhasil ditambahkan!');\n15. tambahkan \n    - @csrf pada form\n    - tambahkan redirect ke buku.index\n    - tambahkan notifikasi pop up success\n            - @if (session('success'))\n            <div class=\"alert alert-success alert-dismissible fade show\" role=\"alert\">\n                {{ session('success') }}\n                <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"alert\" aria-label=\"Close\"></button>\n            </div>\n        @endif\n    - tambahkan notifikasi pop up error\n        @if ($errors->any())\n            <div class=\"alert alert-danger alert-dismissible fade show\" role=\"alert\">\n                <ul class=\"mb-0\">\n                    @foreach ($errors->all() as $error)\n                        <li>{{ $error }}</li>\n                    @endforeach\n                </ul>\n                <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"alert\" aria-label=\"Close\"></button>\n            </div>\n        @endif\n16. Update data book\n        - buat views form Edit Book\n        - buat controller -> edit . untuk menuju view edit dan kirim juga data book\n            - $book = Book::findOrFail($id); //Cari data by ID\n              return view('book.edit-book', compact('book'));\n        - jangan lupa \n            -@csrf\n            @method('PUT')\n            di dalam form\n17. Render data book pada value\n        - {{ old('title', $book['title'] ?? $book->title) }}\n18. Buat function update\n        - lakukan validasi\n            - $validated = $request->validate([\n            'title' => 'required|min:3',\n            'author' => 'required|min:3',\n            'publish_year' => 'required'\n        ]);\n\n        - cari book by ID\n            $book = Book::findOrFail($id);\n        - update data book\n            $book->update($validated);\n        - redirect ke index\n         return redirect()->route('book.index')->with('success', 'Success updated data book');\n19 . Buat route baru \n        - Route::put('/update-book/{id}', [BookController::class, 'update'])->name('book.update');\n20. tambah kan route di form beserta kirimkan juga id nya \n        -    <form action=\"{{ route('book.update', $book['id'] ?? $book->id) }}\" method=\"POST\">\n        - tambahkan juga \n                - @csrf\n                   @method('PUT') <!-- Wajib ada untuk request update di Laravel -->\n21. Membuat fitur Delete\n    - buat route baru \n        - Route::delete('/delete-book/{id}', [BookController::class, 'destroy'])->name('book.destroy');\n    - edit controller -> destroy\n        - cari by ID kemudian delete\n            -$book = Book::findOrFail($id);\n             $book->delete();\n    - redirect ke index\n            - return redirect()->route('book.index')->with('success', 'Deleted book successfully');\n    - panggil route delete di tombol delete menggunakan form\n        - <form action=\"{{ route('book.destroy', $item['id'] ?? $item->id) }}\"\n                                            method=\"POST\" class=\"inline-block m-0\"\n                                            onsubmit=\"return confirm('Are you sure, Delete ?')\">\n                                            @csrf\n                                            @method('DELETE')\n                                            <button type=\"submit\"\n                                                class=\"p-2 text-red-600 hover:bg-red-50 rounded-lg transition\"\n                                                title=\"Delete\">\n                                                <i class=\"fas fa-trash-alt\"></i>\n                                            </button>\n                                        </form>\n\n\n\n\n        \n    \n",
